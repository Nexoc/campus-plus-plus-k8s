# Managed by Ansible. Do not edit directly on the server.

global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - "127.0.0.1:9090"
        labels:
          environment: "{{ monitoring_environment_label }}"
          role: monitoring
          instance: s6-monitoring

  - job_name: node-exporter
    static_configs:
{% for host in groups['all'] | sort %}
      - targets:
          - "{{ hostvars[host].monitoring_scrape_host | default(hostvars[host].ansible_host | default(host)) }}:9100"
        labels:
          environment: "{{ monitoring_environment_label }}"
          instance: "{{ host }}"
{% if host in groups.get('gw', []) %}
          role: gw
{% elif host in groups.get('db', []) %}
          role: db
{% elif host in groups.get('dev', []) %}
          role: dev
{% elif host in groups.get('monitoring', []) %}
          role: monitoring
{% elif host in groups.get('prod', []) %}
          role: prod
{% else %}
          role: server
{% endif %}
{% endfor %}

  - job_name: postgres-exporter
    static_configs:
{% for host in groups.get('db', []) | sort %}
      - targets:
          - "{{ hostvars[host].monitoring_scrape_host | default(hostvars[host].ansible_host | default(host)) }}:9187"
        labels:
          environment: "{{ monitoring_environment_label }}"
          role: db
          instance: "{{ host }}"
{% endfor %}

  - job_name: kube-state-metrics-dev
    static_configs:
{% set dev_host = groups.get('dev', [])[0] %}
      - targets:
          - "{{ kube_state_metrics_dev_scrape_host | default(hostvars[dev_host].kube_state_metrics_scrape_host | default(hostvars[dev_host].monitoring_scrape_host | default(hostvars[dev_host].ansible_host | default(dev_host)))) }}:{{ kube_state_metrics_dev_port | default(30091) }}"
        labels:
          environment: "{{ monitoring_environment_label }}"
          role: k8s
          cluster: dev
          instance: dev

  - job_name: kube-state-metrics-prod
    static_configs:
{% set prod_host = groups.get('prod', [])[0] %}
      - targets:
          - "{{ kube_state_metrics_prod_scrape_host | default(hostvars[prod_host].kube_state_metrics_scrape_host | default(hostvars[prod_host].monitoring_scrape_host | default(hostvars[prod_host].ansible_host | default(prod_host)))) }}:{{ kube_state_metrics_prod_port | default(30092) }}"
        labels:
          environment: "{{ monitoring_environment_label }}"
          role: k8s
          cluster: prod
          instance: prod
